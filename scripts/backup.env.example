# ==============================================================================
# ARC MongoDB Auto Backup — konfigurasi
# Copy ke /opt/arc-backup/backup.env lalu edit sesuai kebutuhan.
# ==============================================================================

# --- MongoDB source ---
# Contoh lokal tanpa auth:  mongodb://localhost:27017
# Contoh dengan auth:       mongodb://user:pass@localhost:27017
# Contoh Atlas:             mongodb+srv://user:pass@cluster.xxxxx.mongodb.net
MONGO_URI="mongodb://localhost:27017"

# Nama database yang di-backup. Kosongkan = dump SEMUA database di server itu.
DB_NAME="arcdb"

# Database untuk otentikasi (default 'admin'). Abaikan kalau MongoDB tanpa auth.
MONGO_AUTH_DB=""                       # isi 'admin' kalau MongoDB pakai auth, kosongkan kalau tanpa auth

# --- Penyimpanan lokal ---
BACKUP_DIR="/var/backups/arc-mongo"
LOG_FILE="/var/log/arc-backup.log"

# --- Rolling retention (hari) ---
RETENTION_DAYS=30

# --- Google Drive via rclone ---
RCLONE_ENABLED=true
RCLONE_REMOTE="gdrive"                 # nama remote saat `rclone config`
RCLONE_DEST_PATH="ARC-Backups"         # folder tujuan di Google Drive
# RCLONE_BWLIMIT="10M"                 # opsional: batasi bandwidth upload

# --- Lock file (untuk cegah tumpang tindih) ---
LOCK_FILE="/tmp/arc-backup.lock"
